{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/config.schema.json",
  "title": "HarnessConfig",
  "description": "Runtime configuration for the Harness pipeline. Loaded from config.json and optionally overlaid with config.local.json. Validated at startup — unknown fields are a fatal error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retries",
    "timeouts",
    "context",
    "agents",
    "gates",
    "retention",
    "analytics",
    "coreLibraries",
    "requirements",
    "git",
    "phases",
    "models",
    "protocol",
    "rll",
    "privacy",
    "codegraph",
    "proofs",
    "interventions",
    "production"
  ],
  "properties": {
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "gate", "e2e", "reconcile"],
      "properties": {
        "agent": { "type": "integer", "minimum": 0, "maximum": 10 },
        "gate": { "type": "integer", "minimum": 0, "maximum": 10 },
        "e2e": { "type": "integer", "minimum": 0, "maximum": 10 },
        "reconcile": {
          "type": "integer",
          "minimum": 0,
          "description": "Max fix attempts after reconcile reports FIX. 0 disables the fix loop (escalate immediately). Default 2."
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildAgentMs", "otherAgentMs", "gateMs", "gracefulShutdownMs"],
      "properties": {
        "buildAgentMs": { "type": "integer", "minimum": 1000 },
        "otherAgentMs": { "type": "integer", "minimum": 1000 },
        "gateMs": { "type": "integer", "minimum": 1000 },
        "gracefulShutdownMs": { "type": "integer", "minimum": 100 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles", "maxTokens"],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 100 }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPromptTokens"],
      "properties": {
        "maxPromptTokens": { "type": "integer", "minimum": 1000 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualDiffThreshold", "visualDiffBlock", "minAcceptanceCriteria"],
      "properties": {
        "visualDiffThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "visualDiffBlock": { "type": "boolean" },
        "minAcceptanceCriteria": { "type": "integer", "minimum": 1 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keepRunLogsForDays", "keepRunFolderForDays"],
      "properties": {
        "keepRunLogsForDays": { "type": "integer", "minimum": 1 },
        "keepRunFolderForDays": { "type": "integer", "minimum": 1 }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotationStrategy"],
      "properties": {
        "rotationStrategy": { "type": "string", "enum": ["monthly"] }
      }
    },
    "coreLibraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "docs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "docs": { "type": "string", "minLength": 1, "format": "uri" }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minNodeVersion", "minClaudeCodeVersion"],
      "properties": {
        "minNodeVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "minClaudeCodeVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["push", "createPR"],
      "properties": {
        "push": { "type": "boolean" },
        "createPR": { "type": "boolean" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["e2e"],
      "properties": {
        "e2e": { "type": "boolean" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultAdapter", "adapters"],
      "properties": {
        "defaultAdapter": { "type": "string", "minLength": 1 },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": [
                  "claude-cli",
                  "fake-local",
                  "openclaw-agent",
                  "openai-compatible",
                  "external"
                ]
              },
              "command": { "type": "string", "minLength": 1 },
              "agentId": { "type": "string", "minLength": 1 },
              "baseUrl": { "type": "string", "minLength": 1 },
              "baseUrlEnv": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "modelEnv": { "type": "string", "minLength": 1 },
              "maxTokens": { "type": "integer", "minimum": 1 },
              "apiKeyEnv": { "type": "string", "minLength": 1 },
              "apiKey": { "type": "string", "minLength": 1 },
              "privacyZone": {
                "type": "string",
                "enum": [
                  "WORKSPACE",
                  "LOCAL_ONLY",
                  "HOSTED_REGIONAL",
                  "ZDR_FRONTIER",
                  "BLIND_SUBTASK",
                  "SECRET_COMMITMENT_ONLY"
                ]
              },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "bus", "receipts"],
      "properties": {
        "version": { "type": "string", "enum": ["2.0"] },
        "bus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store"],
          "properties": {
            "store": { "type": "string", "enum": ["jsonl"] }
          }
        },
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hashAlgorithm"],
          "properties": {
            "hashAlgorithm": { "type": "string", "enum": ["sha256"] }
          }
        }
      }
    },
    "rll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "store", "hashChain", "emitControlSignals", "feedbackOscillation"],
      "properties": {
        "enabled": { "type": "boolean" },
        "store": { "type": "string", "enum": ["jsonl"] },
        "hashChain": { "type": "boolean" },
        "emitControlSignals": { "type": "boolean" },
        "feedbackOscillation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minAlternations", "windowMs", "minStrength"],
          "properties": {
            "minAlternations": { "type": "integer", "minimum": 1 },
            "windowMs": { "type": "integer", "minimum": 1000 },
            "minStrength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultZone", "preflight"],
      "properties": {
        "defaultZone": {
          "type": "string",
          "enum": [
            "WORKSPACE",
            "LOCAL_ONLY",
            "HOSTED_REGIONAL",
            "ZDR_FRONTIER",
            "BLIND_SUBTASK",
            "SECRET_COMMITMENT_ONLY"
          ]
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blockHostedMissionGist", "blockHiddenReasoning"],
          "properties": {
            "blockHostedMissionGist": { "type": "boolean" },
            "blockHiddenReasoning": { "type": "boolean" }
          }
        }
      }
    },
    "codegraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "defaultProvider", "sidecarOnlyRefresh"],
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultProvider": { "type": "string", "enum": ["gitnexus", "none"] },
        "sidecarOnlyRefresh": { "type": "boolean" }
      }
    },
    "proofs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signing", "zkSnarks"],
      "properties": {
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider", "trustLevel"],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": {
              "type": "string",
              "enum": [
                "disabled",
                "local_ephemeral_ed25519",
                "local_operator_file_ed25519",
                "external"
              ]
            },
            "trustLevel": {
              "type": "string",
              "enum": [
                "self_signed",
                "operator_bound",
                "registry_verified",
                "unknown"
              ]
            },
            "privateKeyFile": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timeoutMs": { "type": "integer", "minimum": 100 },
            "fallbackSigners": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command", "timeoutMs"],
                "properties": {
                  "command": { "type": "string", "minLength": 1 },
                  "args": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "timeoutMs": { "type": "integer", "minimum": 100 },
                  "keyId": { "type": "string", "minLength": 1 }
                }
              }
            },
            "failurePolicy": {
              "type": "string",
              "enum": ["halt", "degrade_to_unavailable"]
            },
            "keyId": { "type": "string", "minLength": 1 },
            "expiresAt": { "type": "string", "format": "date-time" },
            "revocationListRef": { "type": "string", "minLength": 1 },
            "revokedKeyIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "zkSnarks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "defaultBackend"],
          "properties": {
            "enabled": { "type": "boolean" },
            "defaultBackend": { "type": "string", "enum": ["mock_local", "external"] },
            "command": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timeoutMs": { "type": "integer", "minimum": 100 },
            "maxOutputBytes": { "type": "integer", "minimum": 1024 },
            "circuitId": { "type": "string", "minLength": 1 },
            "circuitVersion": { "type": "string", "minLength": 1 },
            "verifierRef": { "type": "string", "minLength": 1 },
            "setupHash": { "type": "string", "minLength": 1 },
            "maxLatencyMs": { "type": "integer", "minimum": 1 },
            "failurePolicy": {
              "type": "string",
              "enum": ["fail_closed", "manual_hold", "degrade_to_signature_only_alpha"]
            }
          }
        }
      }
    },
    "interventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dryRunOnly"],
      "properties": {
        "enabled": { "type": "boolean" },
        "dryRunOnly": { "type": "boolean" }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleet", "commandGroup", "council", "canary", "breakGlass"],
      "properties": {
        "fleet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consensusV1ModelsUrls", "consensusV1CatalogFiles", "includeHosted"],
          "properties": {
            "configPath": { "type": "string", "minLength": 1 },
            "v1ModelsUrl": { "type": "string", "minLength": 1 },
            "v1CatalogFile": { "type": "string", "minLength": 1 },
            "consensusV1ModelsUrls": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "consensusV1CatalogFiles": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "minAgreeingSources": { "type": "integer", "minimum": 2 },
            "includeHosted": { "type": "boolean" }
          }
        },
        "commandGroup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "requiredApprovals", "members"],
          "properties": {
            "enabled": { "type": "boolean" },
            "requiredApprovals": { "type": "integer", "minimum": 1 },
            "members": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "council": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minDissenters", "timeoutController"],
          "properties": {
            "minDissenters": { "type": "integer", "minimum": 1 },
            "timeoutController": {
              "type": "object",
              "additionalProperties": false,
              "required": ["seedMs", "floorMs", "capMs", "stepUpMs", "stepDownMs", "disabled"],
              "properties": {
                "seedMs": { "type": "integer", "minimum": 1000 },
                "floorMs": { "type": "integer", "minimum": 1000 },
                "capMs": { "type": "integer", "minimum": 1000 },
                "stepUpMs": { "type": "integer", "minimum": 0 },
                "stepDownMs": { "type": "integer", "minimum": 0 },
                "disabled": { "type": "boolean" }
              }
            }
          }
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "seedConcurrentTasks", "floorConcurrentTasks", "capConcurrentTasks", "stepUp"],
          "properties": {
            "enabled": { "type": "boolean" },
            "seedConcurrentTasks": { "type": "integer", "minimum": 1 },
            "floorConcurrentTasks": { "type": "integer", "minimum": 1 },
            "capConcurrentTasks": { "type": "integer", "minimum": 1 },
            "stepUp": { "type": "integer", "minimum": 1 }
          }
        },
        "breakGlass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxHours", "postHocGateDeadlineHours", "requireRollback"],
          "properties": {
            "maxHours": { "type": "number", "exclusiveMinimum": 0 },
            "postHocGateDeadlineHours": { "type": "number", "exclusiveMinimum": 0 },
            "requireRollback": { "type": "boolean" }
          }
        }
      }
    }
  }
}
